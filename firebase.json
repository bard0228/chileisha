{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
        ]
      },
      {
        "source": "data.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "thumbs/**",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000" }
        ]
      }
    ]
  }
}
